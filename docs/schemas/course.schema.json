{
  "description": "Catalog entry. Creating a course with an existing `code`\nproduces a NEW catalog version (immutability + versioning).",
  "properties": {
    "code": {
      "maxLength": 16,
      "minLength": 2,
      "pattern": "^[A-Z]{2,4}[0-9]{2,4}$",
      "title": "Code",
      "type": "string"
    },
    "title": {
      "maxLength": 128,
      "minLength": 2,
      "title": "Title",
      "type": "string"
    },
    "credits": {
      "maximum": 12,
      "minimum": 0.5,
      "title": "Credits",
      "type": "number"
    },
    "department": {
      "maxLength": 64,
      "minLength": 2,
      "title": "Department",
      "type": "string"
    },
    "prerequisites": {
      "items": {
        "type": "string"
      },
      "title": "Prerequisites",
      "type": "array"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    }
  },
  "required": [
    "code",
    "title",
    "credits",
    "department"
  ],
  "title": "CourseIn",
  "type": "object"
}
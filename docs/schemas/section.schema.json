{
  "$defs": {
    "ScheduleSlot": {
      "description": "教学班每周一次的上课安排。\n\n`day` 采用 ISO 顺序：1=周一 …… 7=周日。时间以自午夜起的分钟数表示，例如 08:30 -> 510。",
      "properties": {
        "day": {
          "maximum": 7,
          "minimum": 1,
          "title": "星期",
          "type": "integer"
        },
        "start_min": {
          "maximum": 1440,
          "minimum": 0,
          "title": "开始分钟",
          "type": "integer"
        },
        "end_min": {
          "exclusiveMinimum": 0,
          "maximum": 1440,
          "title": "结束分钟",
          "type": "integer"
        }
      },
      "required": [
        "day",
        "start_min",
        "end_min"
      ],
      "title": "ScheduleSlot",
      "type": "object"
    }
  },
  "properties": {
    "course_code": {
      "title": "课程代码",
      "type": "string"
    },
    "semester": {
      "pattern": "^\\d{4}(SP|FA|SU)$",
      "title": "学期",
      "type": "string"
    },
    "section_no": {
      "maxLength": 8,
      "minLength": 1,
      "title": "教学班编号",
      "type": "string"
    },
    "instructor_name": {
      "title": "授课教师",
      "type": "string"
    },
    "capacity": {
      "maximum": 500,
      "minimum": 1,
      "title": "容量",
      "type": "integer"
    },
    "venue": {
      "title": "上课地点",
      "type": "string"
    },
    "slots": {
      "items": {
        "$ref": "#/$defs/ScheduleSlot"
      },
      "minItems": 1,
      "title": "时间段",
      "type": "array"
    }
  },
  "required": [
    "course_code",
    "semester",
    "section_no",
    "instructor_name",
    "capacity",
    "venue",
    "slots"
  ],
  "title": "SectionIn",
  "type": "object"
}